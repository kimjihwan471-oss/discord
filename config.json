name: Spoon Live Notifier

on:
  schedule:
    - cron: "*/5 * * * *"   # 5분마다 (GitHub 최소 간격, 몇 분 지연될 수 있음)
  workflow_dispatch:         # 수동 실행 버튼

permissions:
  contents: write            # state.json 저장용

concurrency:
  group: spoon-notifier
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Check Spoon lives and notify Discord
        env:
          WEBHOOK_URL: ${{ secrets.WEBHOOK_URL }}
        run: python3 spoon_notifier.py --once

      - name: Save state
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add state.json
          git diff --cached --quiet || (git commit -m "update state" && git push)
